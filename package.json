{
  "name": "action-desk-app",
  "private": true,
  "version": "0.6.0",
  "description": "Action Desk Windows pilot desktop app for inbox triage.",
  "author": "Action Desk",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:addin": "vite --open /taskpane.html",
    "dev:electron": "electron .",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npm run dev:electron\"",
    "build": "tsc -b && vite build",
    "build:addin": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run build && npm run build:electron",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "desktop:prep": "npm run build:electron && npm run rebuild:native",
    "ensure:test-native": "node scripts/ensure-node-better-sqlite3.cjs",
    "lint": "eslint .",
    "pack:desktop": "npm run build:all && electron-builder --dir",
    "package:win": "npm run build:all && electron-builder --win nsis",
    "pretest": "npm run ensure:test-native",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.6.2",
    "@azure/msal-node": "^5.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "mariadb": "^3.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  },
  "build": {
  "appId": "com.actiondesk.desktop",
  "productName": "Action Desk",
  "icon": "build/icon.ico",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "src/config/actionDeskLocations.json",
      "package.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ActionDesk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
